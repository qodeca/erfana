    "dir": "src/renderer",
    "ext": [
      ".tsx"
    ],
    "excludePath": "\\.test\\.",
    "match": "size=\\{([0-9]+)\\}",
    "group": 1
  },
  "icon-size-offscale": {
    "kind": "distinct",
    "card": "system/components/icon/index.html",
    "label": "distinct literal icon sizes that are not on the 12/16/20/24/32 scale",
    "dir": "src/renderer",
    "ext": [
      ".tsx"
    ],
    "excludePath": "\\.test\\.",
    "match": "size=\\{(?!(?:12|16|20|24|32)\\})([0-9]+)\\}",
    "group": 1
  },
  "icon-size-offscale-list": {
    "kind": "list",
    "card": "system/components/icon/index.html",
    "label": "the off-scale literal icon sizes, in px",
    "dir": "src/renderer",
    "ext": [
      ".tsx"
    ],
    "excludePath": "\\.test\\.",
    "match": "size=\\{(?!(?:12|16|20|24|32)\\})([0-9]+)\\}",
    "group": 1
  },
  "icon-registry-importers": {
    "kind": "count",
    "card": "system/components/icon/index.html",
    "label": "files importing from the icon registry",
    "dir": "src/renderer",
    "ext": [
