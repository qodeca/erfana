  "icon-size-literals": {
    "kind": "count",
    "card": "system/components/icon/index.html",
    "label": "icons sized with a literal size={N} instead of a token",
    "dir": "src/renderer",
    "ext": [
      ".tsx"
    ],
    "excludePath": "\\.test\\.",
    "match": "size=\\{[0-9]+\\}",
    "unit": "matches"
