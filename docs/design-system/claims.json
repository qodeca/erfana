  "context-menu-dependants": {
    "kind": "count",
    "card": "system/components/menu/index.html",
    "label": "files that import a context menu component (a value import of ContextMenu, EditorContextMenu, TerminalContextMenu, PreviewContextMenu or TextareaContextMenu – not a type, helper or hook)",
    "dir": "src/renderer",
    "ext": [
      ".tsx",
      ".ts"
    ],
    "excludePath": "\\.test\\.|components/ContextMenu/",
    "match": "^import \\{[^}]*\\b[A-Za-z]*ContextMenu\\b[^}]*\\} from '[^']*/ContextMenu/[A-Za-z]*ContextMenu'",
