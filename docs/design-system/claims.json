{
  "$comment": [
    "Every number a card states lives here, with the code that derives it.",
    "A card writes <span data-claim=\"id\"></span>; scripts/design-sync.mjs (npm run design) evaluates the",
    "predicate with scripts/lib/design-claims.mjs and BAKES the value into the card's own text, so the",
    "cards stay static HTML with no JavaScript. `npm run design -- --check` and scripts/design-claims.test.mjs",
    "re-derive every value on each CI run and fail, naming the card and line, when the baked text is stale.",
    "A data-claim id with no entry here, or an entry no card names, fails that check. Nothing scans a card",
    "for hand-typed digits: a count of the app belongs here, a value a card decides may be literal.",
    "See scripts/lib/design-claims.mjs for the predicate kinds and their limits."
  ],
  "spinner-keyframes": {
    "kind": "count",
    "card": "system/foundations/motion.html",
    "label": "spin keyframes in the renderer",
    "dir": "src/renderer",
    "ext": [
      ".css"
    ],
    "match": "@keyframes\\s+[A-Za-z0-9_-]*[Ss]pin\\b",
    "unit": "matches"
  },
  "spinner-durations": {
    "kind": "distinct",
    "card": "system/foundations/motion.html",
    "label": "distinct durations those spinners run at",
    "dir": "src/renderer",
    "ext": [
      ".css"
    ],
    "match": "animation:\\s*[A-Za-z0-9_-]*[Ss]pin\\s+([0-9.]+m?s)",
    "group": 1
  },
  "icon-registry-bypass": {
    "kind": "countWithout",
    "card": "system/components/icon/index.html",
    "label": "files importing the icon library directly instead of the registry",
    "dir": "src/renderer",
    "ext": [
      ".ts",
      ".tsx"
    ],
    "excludePath": "\\.test\\.|iconRegistry",
    "match": "from 'lucide-react'",
    "without": "iconRegistry"
  },
  "prefers-color-scheme-blocks": {
    "kind": "count",
    "card": "system/foundations/colors.html",
    "label": "prefers-color-scheme blocks shipping in the renderer",
    "dir": "src/renderer",
    "ext": [
      ".css"
    ],
    "match": "@media[^{]*prefers-color-scheme",
    "unit": "matches"
  },
  "aria-invalid-uses": {
    "kind": "count",
    "card": "system/components/form/index.html",
    "label": "places the renderer marks a field invalid to assistive tech",
    "dir": "src/renderer",
    "ext": [
      ".ts",
      ".tsx"
    ],
    "excludePath": "\\.test\\.",
    "match": "aria-invalid",
    "unit": "matches"
  },
  "zindex-css-literals": {
    "kind": "count",
    "card": "system/foundations/layering.html",
    "label": "stylesheets setting a bare z-index on the app-wide ladder (the documented local stacking in CameraDialog.css and the off-screen park in TerminalPanel.css excluded)",
    "dir": "src/renderer",
    "ext": [
      ".css"
    ],
    "excludePath": "design-tokens\\.css|Panels/TerminalPanel\\.css$|Dialog/CameraDialog\\.css$",
    "match": "z-index:\\s*[0-9]",
    "unit": "files"
  },
  "zindex-js-literals": {
    "kind": "count",
    "card": "system/foundations/layering.html",
    "label": "renderer files mirroring a z-index into TypeScript",
    "dir": "src/renderer",
    "ext": [
      ".ts",
      ".tsx"
    ],
    "excludePath": "\\.test\\.",
    "match": "[Zz]_?[Ii][Nn][Dd][Ee][Xx]\\s*[:=]\\s*\\{?\\s*-?[0-9]",
    "unit": "files"
  },
  "colour-tokens": {
    "kind": "count",
    "card": "system/foundations/colors.html",
    "label": "colour tokens declared in design-tokens.css",
    "dir": "src/renderer/src/styles",
    "ext": [
      ".css"
    ],
    "includePath": "design-tokens\\.css",
    "match": "^\\s*--color-[\\w-]+\\s*:",
    "unit": "matches"
  },
  "animating-stylesheets": {
    "kind": "count",
    "card": "system/foundations/motion.html",
    "label": "renderer stylesheets that declare a keyframe animation",
    "dir": "src/renderer",
    "ext": [
      ".css"
    ],
    "match": "@keyframes",
    "unit": "files"
  },
  "reduced-motion-entry-rules": {
    "kind": "count",
    "card": "system/foundations/motion.html",
    "label": "app-wide reduced-motion blocks in the renderer entry stylesheet",
    "dir": "src/renderer/src",
    "ext": [
      ".css"
    ],
    "includePath": "^src/renderer/src/index\\.css$",
    "match": "@media[^{]*prefers-reduced-motion:\\s*reduce",
    "unit": "matches"
  },
  "contrast-secondary-on-panel": {
    "kind": "contrast",
