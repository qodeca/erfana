# Default: let git handle text normalization
* text=auto

# Whisper trust-chain test fixtures must keep LF endings — the .minisig
# signature was computed against the exact LF bytes of manifest.fixture.json.
# Allowing autocrlf to convert these on Windows checkout breaks signature
# verification (verifyManifest.test.ts fails locally only).
src/main/utils/__fixtures__/manifest.fixture.json text eol=lf
src/main/utils/__fixtures__/manifest.fixture.json.minisig text eol=lf

# Shell scripts must stay LF on every host (Windows-checkout safety)
*.sh text eol=lf

# patch-package patches must stay LF — autocrlf converting them to CRLF on
# Windows checkout breaks patch application (patches/node-pty+1.1.0.patch
# is applied at install time by the postinstall hook).
patches/*.patch text eol=lf

# design-sync generated pages must stay LF – scripts/design-sync.mjs builds
# these from template strings as LF and byte-compares them in --check mode, so a
# CRLF checkout on Windows makes `npm run design -- --check` fail on every run
# (#104). Every other generated file under docs/design-system/ is a byte copy of
# a src/ file and follows that file's line endings, and the baked cards are
# spliced in place, so they keep whatever endings the checkout gave them.
docs/design-system/index.html text eol=lf
docs/design-system/deviations.html text eol=lf
docs/designs/index.html text eol=lf

# The preload surface snapshot must stay LF — it is LF in the repo, and this
# keeps a local Windows checkout (autocrlf) or a snapshot update run there from
# rewriting it to CRLF and showing the whole file as changed.
src/preload/__snapshots__/surface.test.ts.snap text eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.dmg binary
*.exe binary
*.dll binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.traineddata binary

# HTML Preview comment fixtures are byte-exact goldens: LF, CRLF and CR-only
# files on purpose, pinned by SHA-256 in v1.lock.json (G-003) and replayed by
# the agent-review check (X-001). Line-ending conversion would change them.
src/shared/htmlComments/__fixtures__/** -text
# Spec 024: the frozen v0.23.1 parser and writer, and every new comment fixture
# folder, keep their bytes exactly (SHA-256 locks).
src/shared/comments/__fixtures__/** -text
e2e/fixtures/html-preview-corpus/comments/** -text

# Spec 024 pin snapshots stay LF on every checkout, like the preload surface
# snapshot above, so a Windows checkout compares the same bytes.
src/preload/__snapshots__/previewPage.surface.pin.test.ts.snap text eol=lf
src/shared/ipc/__snapshots__/preview-comment-schema.pin.test.ts.snap text eol=lf
src/renderer/src/components/Comments/__snapshots__/commentCopy.pin.test.ts.snap text eol=lf
