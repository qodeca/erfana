# Required for audio transcription E2E tests (tests skip gracefully if unset)
OPENAI_API_KEY=

# Optional: vitest worker cap for this machine (default: half the cores, at least 2).
# A count ("8") or a share of the cores ("75%"). Read from the shell environment,
# so export it (or prefix a single run) - see CONTRIBUTING.md.
# VITEST_MAX_WORKERS=75%
