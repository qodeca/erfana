{
  "name": "erfana",
  "version": "0.23.1",
  "description": "An agent-native Markdown workspace that runs terminal coding agents like Claude Code beside your editor",
  "main": "./out/main/index.js",
  "author": "Qodeca sp. z o.o.",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix && npm run lint:shebang && npm run lint:max-lines",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts && npm run lint:shebang && npm run lint:max-lines",
    "lint:shebang": "node scripts/check-shebangs.mjs",
    "lint:max-lines": "node scripts/check-max-lines.mjs",
    "lint:css": "stylelint \"src/**/*.css\" \"docs/design-system/**/*.css\" \"docs/design-system/**/*.html\" \"docs/designs/**/*.css\" \"docs/designs/**/*.html\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test:node": "tsc --noEmit -p tsconfig.node.test.json",
    "typecheck:test:web": "tsc --noEmit -p tsconfig.web.test.json",
    "typecheck:test:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:test": "npm run typecheck:test:node && npm run typecheck:test:web && npm run typecheck:test:e2e",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:ci": "vitest --run --reporter=dot",
    "test:main": "vitest --run --config vitest.main.config.ts --project main --project main-perf",
    "test:preload": "vitest --run --config vitest.preload.config.ts --project preload",
    "test:renderer": "vitest --run --config vitest.renderer.config.ts --project renderer",
    "test:cov": "node scripts/test-cov.mjs",
    "check:headers": "node scripts/check-spdx-headers.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:version-drift": "node scripts/check-version-drift.mjs",
    "docs:screenshots": "node scripts/capture/run.mjs",
    "docs:brand": "node scripts/capture/brand.mjs",
    "design": "node scripts/design-sync.mjs",
    "fixtures:html-comments": "esbuild src/shared/htmlComments/__fixtures__/gen/genFixtures.ts --bundle --platform=node --sourcemap --log-level=warning --outfile=temp/fixtures-html-comments.cjs && node --enable-source-maps temp/fixtures-html-comments.cjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && install-electron && electron-builder install-app-deps",
    "prebuild": "node scripts/prebuild.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:test": "npm run build && ERFANA_TEST_BUILD=true electron-builder --mac -c.productName=\"Erfana (TEST BUILD)\" -c.directories.output=release/test/${npm_package_version}",
    "test:e2e": "electron-vite build && playwright test --project=electron",
    "test:e2e:no-build": "playwright test --project=electron",
    "test:e2e:linux": "bash scripts/e2e-linux.sh",
    "test:e2e:headed": "electron-vite build && playwright test --project=electron --headed",
    "test:e2e:visual": "electron-vite build && playwright test --project=visual",
    "test:e2e:update-screenshots": "electron-vite build && playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@llamaindex/liteparse": "2.15.1",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "1.8.0",
    "@turbodocx/html-to-docx": "^1.23.1",
    "async-mutex": "^0.5.0",
    "chokidar": "5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "isomorphic-git": "^1.44.3",
    "js-yaml": "^4.3.1",
    "music-metadata": "^12.3.2",
    "node-pty": "^1.0.0",
    "parse5": "^8.0.1",
    "tar": "7.5.22",
    "yauzl": "3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "^2.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-virtual": "3.14.21",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^4.9.0",
    "dotenv": "^17.3.1",
    "electron": "^44.9.0",
    "electron-builder": "26.18.0",
    "electron-playwright-helpers": "^2.0.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.10.2",
    "hast-util-sanitize": "^5.0.2",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.545.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.55.1",
    "patch-package": "^8.0.1",
    "path-browserify": "^1.0.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "shx": "^0.4.0",
    "stylelint": "^17.16.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "chokidar": "5.0.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "dompurify": "^3.4.17"
  }
}
