{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "circuit-electron",
    "xezar",
    "chrome-devtools"
  ],
 "permissions": {
    "allow": [
      "Bash(node scripts/stop-orphan-mcp.mjs)",
      "Bash(node scripts/stop-orphan-mcp.mjs --dry-run)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.xezar/checks/leader-context.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
