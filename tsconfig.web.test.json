{
  "extends": "./tsconfig.web.json",
  "include": [
    "src/renderer/**/*",
    "src/preload/*.d.ts",
    "tests/setup/setupTests.renderer.ts",
    "tests/setup/flakeGuard.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["electron-vite/node", "vitest/globals"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
